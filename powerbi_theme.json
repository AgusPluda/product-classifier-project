            "axisColor": "#c3c2b7",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#e1e0d9"
              }
            },
            "axisColor": "#c3c2b7",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#e1e0d9"
              }
            },
            "axisColor": "#c3c2b7",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#e1e0d9"
              }
            },
            "axisColor": "#c3c2b7",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#52514e"
              }
            }
          }
        ]
      }
