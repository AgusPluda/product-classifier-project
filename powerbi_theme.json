{
  "name": "Product Classifier",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
