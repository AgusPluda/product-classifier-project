        "values": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#0b0b0b"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514e"
              }
